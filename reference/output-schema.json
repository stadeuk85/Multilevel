{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stadeuk85/EHCP-Golden-Thread-Editor/reference/output-schema.json",
  "title": "EHCP Golden Thread Editor Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "verdict",
    "priority_findings",
    "golden_thread_breaks",
    "evidence_alignment",
    "clarifications",
    "strengths",
    "human_review",
    "self_check"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_stage",
        "review_scope",
        "evidence_supplied",
        "limitations",
        "priority_finding_count_note"
      ],
      "properties": {
        "document_stage": {
          "type": "string",
          "minLength": 1
        },
        "review_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_supplied": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority_finding_count_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priority_findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "golden_thread_breaks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "source_ids",
          "explanation",
          "confidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "orphan_need",
              "unsupported_outcome",
              "unserved_outcome",
              "unanchored_provision",
              "partial_thread"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "evidence_alignment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "recommendation_quote",
          "recommendation_location",
          "draft_location",
          "classification",
          "missing_or_altered_elements",
          "human_action"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "recommendation_quote": {
            "type": "string",
            "minLength": 1
          },
          "recommendation_location": {
            "type": "string",
            "minLength": 1
          },
          "draft_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "enum": [
              "included",
              "partially_included",
              "omitted",
              "contradicted",
              "unclear"
            ]
          },
          "missing_or_altered_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "human_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "location",
          "explanation"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_role",
        "reviewed_at",
        "unresolved_matters"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved_for_editorial_use",
            "return_for_correction",
            "specialist_review_required",
            "do_not_use"
          ]
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "unresolved_matters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_replacement_wording",
        "no_invented_facts",
        "authority_types_distinguished",
        "uncertainty_visible",
        "sensitive_data_minimised",
        "human_review_completed"
      ],
      "properties": {
        "no_replacement_wording": {
          "const": true
        },
        "no_invented_facts": {
          "const": true
        },
        "authority_types_distinguished": {
          "const": true
        },
        "uncertainty_visible": {
          "const": true
        },
        "sensitive_data_minimised": {
          "const": true
        },
        "human_review_completed": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "authorityCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "authority_id",
        "locator",
        "checked_date"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "statutory_duty",
            "regulation",
            "statutory_guidance",
            "local_policy"
          ]
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "checked_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "confidence",
        "section",
        "location",
        "draft_quote",
        "evidence_quote",
        "defect",
        "why_it_matters",
        "basis",
        "authority_citations",
        "revision_task"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^P[1-3]$"
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "moderate",
            "minor"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "draft_quote": {
          "type": "string",
          "minLength": 1
        },
        "evidence_quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "defect": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "statutory_duty",
              "regulation",
              "statutory_guidance",
              "professional_evidence",
              "local_policy",
              "internal_consistency",
              "editorial_good_practice"
            ]
          }
        },
        "authority_citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authorityCitation"
          }
        },
        "revision_task": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
